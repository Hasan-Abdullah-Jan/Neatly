# Required for the app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Playwright end-to-end test account.
# Use a dedicated test space. Never commit real credentials.
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=http://127.0.0.1:4173

# Never put the Supabase service-role key in a VITE_ variable or browser env.
# Configure SUPABASE_SERVICE_ROLE_KEY and ALLOWED_ORIGIN as Edge Function secrets.
